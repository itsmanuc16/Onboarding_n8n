      "parameters": {
        "jsCode": "const permitidas = ['equipos_accesos', 'documentos', 'otro'];\nconst recibido = $input.first().json;\nlet r = recibido.text ?? recibido.output ?? recibido;\nif (typeof r === 'string') { try { r = JSON.parse(r); } catch { r = null; } }\nconst valida = r && typeof r === 'object'\n  && permitidas.includes(r.categoria)\n  && typeof r.resumen === 'string' && r.resumen.trim() !== ''\n  && typeof r.requiere_revision === 'boolean';\nif (!valida) {\n  return [{ json: { estado_ia: 'respuesta_no_valida',\n    nota_ia: '\\n\\nObservaciones (IA): respuesta no válida; revisar manualmente.' } }];\n}\nconst marca = r.requiere_revision ? '[REVISAR] ' : '';\nreturn [{ json: {\n  estado_ia: r.requiere_revision ? 'revision_humana' : 'estructura_valida',\n  nota_ia: '\\n\\n' + marca + 'Observaciones (IA) · ' + r.categoria + ': ' + r.resumen.trim()\n} }];"

    {
      "parameters": {
        "jsCode": "// Solo lectura: busca la tarjeta del colaborador. No crea, mueve ni borra nada.\nconst entrada = $('Preparar consulta').first().json;\nconst tarjetas = Array.isArray($('GET tarjetas Trello').first().json.body) ? $('GET tarjetas Trello').first().json.body : [];\nconst listas = Array.isArray($('GET listas Trello').first().json.body) ? $('GET listas Trello').first().json.body : [];\n\n// Normaliza: quita '=' inicial (tarjetas antiguas), tildes, mayúsculas y espacios extra\nconst norm = s => String(s ?? '').replace(/^=/, '').normalize('NFD').replace(/[̀-ͯ]/g, '')\n  .toLowerCase().replace(/\\s+/g, ' ').trim();\n// \"Onboarding Andrea Gómez · TI\" -> \"andrea gomez\"\nconst soloNombre = s => {\n  const n = norm(s);\n  const m = n.match(/^(?:onboarding\\s+)?(.+?)\\s+·\\s+.+$/);\n  return m ? m[1] : n.replace(/^onboarding\\s+/, '');\n};\n\nconst buscado = soloNombre(entrada.nombre);\nconst exactas = tarjetas.filter(t => soloNombre(t.name) === buscado);\nconst palabras = buscado.split(' ');\nconst parciales = tarjetas.filter(t => {\n  const w = soloNombre(t.name).split(' ');\n  return palabras.every(p => w.includes(p));\n});\nconst candidatas = exactas.length ? exactas : parciales;\nconst base = { origen: 'trello', solo_lectura: true };\n\nif (candidatas.length === 0) {\n  return [{ json: { ...base, estado: 'no_encontrado', encontrado: false, lista: '', titulo: entrada.nombre,\n    motivo: 'No hay una tarjeta de onboarding con ese nombre en el tablero.' } }];\n}\nif (candidatas.length > 1) {\n  return [{ json: { ...base, estado: 'entrada_no_valida', encontrado: false, lista: '', titulo: entrada.nombre,\n    motivo: 'Nombre ambiguo: hay varias tarjetas. Pide el nombre completo o el área.',\n    coincidencias: candidatas.map(t => String(t.name).replace(/^=/, '')) } }];\n}\nconst tarjeta = candidatas[0];\nconst lista = listas.find(l => l.id === tarjeta.idList);\nreturn [{ json: { ...base, estado: 'consultado', encontrado: true, lista: lista?.name ?? '',\n  titulo: String(tarjeta.name).replace(/^=/, '') } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
